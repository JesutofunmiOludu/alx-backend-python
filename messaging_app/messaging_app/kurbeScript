#!/usr/bin/env bash

# kurbeScript - Start Kubernetes locally and verify setup

set -e

echo "🔍 Checking if Minikube is installed..."

if ! command -v minikube >/dev/null 2>&1; then
    echo "❌ Minikube is NOT installed."
    echo "👉 Install using:"
    echo "   Windows (Git Bash):  curl -LO https://storage.googleapis.com/minikube/releases/latest/minikube-installer.exe"
    echo "   Then run: ./minikube-installer.exe"
    exit 1
fi

echo "✅ Minikube is installed."

echo "🚀 Starting Kubernetes cluster using Minikube..."
minikube start

echo "⏳ Waiting for cluster to initialize..."
sleep 5

echo "🔎 Verifying Kubernetes cluster status..."
kubectl cluster-info

echo "📦 Retrieving available pods in all namespaces..."
kubectl get pods --all-namespaces

echo "🎉 Kubernetes setup complete!"
